{
  "name": "odin",
  "version": "0.1.0",
  "description": "Terminal-first viewer for Markdown files.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "odin": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "start": "bun run src/index.tsx",
    "dev": "bun run src/index.tsx",
    "preview": "bun run src/index.tsx --",
    "link": "bun link"
  },
  "dependencies": {
    "@opentui/core": "^0.2.15",
    "@opentui/solid": "^0.2.15",
    "marked": "^17.0.1",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^24.12.2",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.10"
}
