{
  "name": "odin-md",
  "version": "0.1.3",
  "description": "Terminal-first viewer for Markdown files.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "odin": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "start": "bun run src/index.ts",
    "dev": "bun run src/index.ts",
    "preview": "bun run src/index.ts --",
    "link": "bun link"
  },
  "dependencies": {
    "@opentui/core": "^0.2.15",
    "@opentui/solid": "^0.2.15",
    "marked": "^17.0.1",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^24.12.2",
    "typescript": "^5.8.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.10"
}
